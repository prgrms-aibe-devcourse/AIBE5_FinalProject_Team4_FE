# ==============================================
# 옷장난감 FE 운영 빌드·배포 환경 변수
# ==============================================
# deploy/.env 로 복사 후 값을 채우세요. Git에 올리지 않습니다.
# BE deploy/.env 의 APP_BASE_URL, FE_BASE_URL, CORS_ALLOWED_ORIGINS 과 함께 맞춥니다.
# BE AWS 가이드: AIBE5_FinalProject_Team4_BE/docs/deploy/aws-setup.md
# ==============================================

# --- Vite 빌드 (필수) ---

# BE 공개 URL (HTTPS, trailing slash 없음)
# 예: https://api.example.com
VITE_API_BASE_URL=

# 운영 OAuth 사용 (개발 mock 토큰 비활성)
VITE_USE_REAL_AUTH=true

# --- S3 + CloudFront 정적 호스팅 (deploy-s3.sh) ---

AWS_REGION=ap-northeast-2
# FE 정적 파일 버킷 (BE 이미지 S3 버킷과 분리 권장)
S3_BUCKET=
# CloudFront 배포 ID — 캐시 무효화용. 없으면 s3 sync만 수행
CLOUDFRONT_DISTRIBUTION_ID=

# --- EC2 + Nginx 정적 호스팅 (deploy-ec2.sh) ---

# 예: ec2-xx-xx-xx-xx.ap-northeast-2.compute.amazonaws.com
EC2_HOST=
EC2_USER=ec2-user
EC2_DEPLOY_PATH=/var/www/closetnangam
# 로컬 SSH 개인키 경로 (예: ~/.ssh/closetnangam.pem)
EC2_SSH_KEY=
